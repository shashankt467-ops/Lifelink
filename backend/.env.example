# Anti Gravity Healthcare API - Cloud Deployment Environment Variables
# Copy this file to .env or configure these variables in your Render / Railway cloud dashboard

# Application Environment
APP_ENV=production
SECRET_KEY=generate-a-secure-random-secret-key

# CORS Allowed Origins (Comma-separated list of deployed frontend URLs)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Database URL (Optional: Cloud-hosted PostgreSQL e.g. Supabase, Neon, Render Postgres)
DATABASE_URL=postgresql://user:password@cloud-db-host:5432/dbname

# Optional Integrations
OPENAI_API_KEY=
