# Anti Gravity Healthcare Platform - Frontend Environment Variables
# Copy this file to .env or configure in Vercel Project Settings -> Environment Variables

# Live Production Backend URL (Render Deployment URL)
VITE_API_URL=https://YOUR-RENDER-BACKEND-URL

# Firebase Authentication Configuration (Optional for production auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
